class Payment {

private:
    string paymentId;
    double amount;
    string status;

public:

    Payment(string id, double amt, string s) {

        if (amt < 0) {
            throw PaymentException(
                "Payment amount cannot be negative."
            );
        }

        if (id.empty()) {
            throw PaymentException(
                "Payment ID cannot be empty."
            );
        }

        this->paymentId = id;
        this->amount = amt;
        this->status = s;
    }


    void displayPayment() const {

        cout << "\n--- Payment Details ---" << endl;

        cout << "Payment ID: "
             << paymentId << endl;

        cout << "Amount: Rs. "
             << amount << endl;

        cout << "Status: "
             << status << endl;
    }
};

class Fee {

private:
    string feeType;
    double amount;

public:

    Fee(string type, double amt) {

        if (amt < 0) {
            throw PaymentException(
                "Fee amount cannot be negative."
            );
        }

        this->feeType = type;
        this->amount = amt;
    }


    // BASIC-TO-CLASS TYPE CASTING

    Fee(double amt) {

        if (amt < 0) {
            throw PaymentException(
                "Fee amount cannot be negative."
            );
        }

        feeType = "Miscellaneous Fee";
        amount = amt;
    }


    // CLASS-TO-BASIC TYPE CASTING

    operator double() const {
        return amount;
    }


    // CLASS-TO-CLASS TYPE CASTING

    operator Payment() const;


    double getAmount() const {
        return amount;
    }


    string getFeeType() const {
        return feeType;
    }


    friend Fee operator+(const Fee& fee1, const Fee& fee2);


    void displayFee() const {

        cout << "\n--- Fee Details ---" << endl;

        cout << "Fee Type: "
             << feeType << endl;

        cout << "Amount: Rs. "
             << amount << endl;
    }
};


// FRIEND FUNCTION FOR FEE

Fee operator+(const Fee& fee1, const Fee& fee2) {

    return Fee(
        fee1.feeType + " + " + fee2.feeType,
        fee1.amount + fee2.amount
    );
}


// CLASS-TO-CLASS TYPE CASTING

Fee::operator Payment() const {

    return Payment("PAY-CONV", amount, "Pending");
}

template <typename T>

void displayRecord(const string& label, const T& value) {

    cout << label << value << endl;
}

template <typename T>

class CampusRegistry {

private:
    vector<T> records;

public:

    void add(const T& record) {
        records.push_back(record);
    }


    void display(const string& title) const {

        cout << "\n--- " << title << " ---" << endl;

        if (records.empty()) {

            cout << "No records available." << endl;
            return;
        }

        for (const T& record : records) {
            cout << record << endl;
        }
    }


    size_t size() const {
        return records.size();
    }
};

class Attendance {

private:
    string studentId;
    string courseCode;

    int totalClasses;
    int attendedClasses;

public:

    Attendance(string sid,
               string cid,
               int total,
               int attended) {

        if (total < 0 || attended < 0 || attended > total) {

            throw InvalidAttendanceException(
                "Attendance values must be valid, and attended classes cannot exceed total classes."
            );
        }

        this->studentId = sid;
        this->courseCode = cid;
        this->totalClasses = total;
        this->attendedClasses = attended;
    }


    double calculatePercentage() const {

        if (totalClasses == 0)
            return 0;

        return (double(attendedClasses) / totalClasses) * 100;
    }


    void displayAttendance() const {

        cout << "\n--- Attendance ---" << endl;

        cout << "Student ID: "
             << studentId << endl;

        cout << "Course Code: "
             << courseCode << endl;

        cout << "Total Classes: "
             << totalClasses << endl;

        cout << "Classes Attended: "
             << attendedClasses << endl;

        cout << "Attendance Percentage: "
             << calculatePercentage()
             << "%" << endl;
    }
};

