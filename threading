class CampusThread {

private:
    string taskName;

public:

    CampusThread(string name) {
        taskName = name;
    }


    void run() {

        for (int i = 1; i <= 3; i++) {

            {
                lock_guard<mutex> lock(outputMutex);

                cout << taskName
                     << " is executing. Step: "
                     << i << endl;
            }

            // SLEEP METHOD

            this_thread::sleep_for(
                chrono::milliseconds(500)
            );
        }
    }
};

class AttendanceTask {

public:

    // Function call operator

    void operator()() {

        for (int i = 1; i <= 3; i++) {

            {
                lock_guard<mutex> lock(outputMutex);

                cout << "Attendance Task executing: "
                     << i << endl;
            }

            this_thread::sleep_for(
                chrono::milliseconds(500)
            );
        }
    }
};

class AttendanceCounter {

private:

    int count = 0;

    mutex mtx;

public:

    void markAttendance() {

        // Lock the mutex

        lock_guard<mutex> lock(mtx);

        count++;
    }


    int getAttendance() {

        lock_guard<mutex> lock(mtx);

        return count;
    }
};

