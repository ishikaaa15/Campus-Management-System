};

class Finally {
private:
    function<void()> action;

public:
    explicit Finally(function<void()> fn) : action(fn) {}

    Finally(const Finally&) = delete;
    Finally& operator=(const Finally&) = delete;

    ~Finally() {
        if (action)
            action();
    }
};

