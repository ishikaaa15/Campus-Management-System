class User {

private:
    string userId;
    string name;

protected:
    string email;

public:

    User(string id, string n, string e) {
        this->userId = id;
        this->name = n;
        this->email = e;
    }

    string getUserId() const {
        return userId;
    }

    string getName() const {
        return name;
    }

    void displayUser() const {
        cout << "ID: " << userId << endl;
        cout << "Name: " << name << endl;
        cout << "Email: " << email << endl;
    }

    virtual void displayRole() const {
        cout << "Role: General User" << endl;
    }

    virtual ~User() {}
};

class Student : virtual public User {

private:
    string department;
    int semester;

    static int totalStudents;

public:

    class ContactDetails {

    private:
        string phone;
        string address;

    public:

        ContactDetails(string p = "", string a = "") {
            this->phone = p;
            this->address = a;
        }

        void displayContact() const {
            cout << "Phone: " << phone << endl;
            cout << "Address: " << address << endl;
        }
    };

    ContactDetails contact;


    Student(string id,
            string name,
            string email,
            string dept,
            int sem,
            string phone = "",
            string address = "")

        : User(id, name, email),
          contact(phone, address) {

        if (id.empty() || name.empty() || email.empty()) {
            throw InvalidStudentException(
                "Student ID, name, and email cannot be empty."
            );
        }

        if (sem < 1 || sem > 8) {
            throw InvalidStudentException(
                "Semester must be between 1 and 8."
            );
        }

        this->department = dept;
        this->semester = sem;

        totalStudents++;
    }


    static void displayTotalStudents() {
        cout << "Total Students Registered: "
             << totalStudents << endl;
    }


    void displayRole() const override {
        cout << "Role: Student" << endl;
    }


    friend ostream& operator<<(ostream& out, const Student& s);

    friend istream& operator>>(istream& in, Student& s);


    void displayStudent() const {

        cout << "\n--- Student Details ---" << endl;

        cout << "ID: " << getUserId() << endl;
        cout << "Name: " << getName() << endl;
        cout << "Email: " << email << endl;
        cout << "Department: " << department << endl;
        cout << "Semester: " << semester << endl;

        cout << "\nContact Details:" << endl;

        contact.displayContact();
    }
};


